---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout title={`页面未找到 — ${site.name}`} description="请求的页面不存在。">
  <main class="not-found">
    <p class="eyebrow">404 · NOT FOUND</p>
    <h1>这条路暂时<br />没有内容。</h1>
    <p>地址可能写错了，或者页面已经移动。</p>
    <a class="button" href="/">返回首页 <span aria-hidden="true">→</span></a>
  </main>
</BaseLayout>
