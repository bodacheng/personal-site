---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { site } from '../../../config/site';
---

<BaseLayout
  title={`${site.headClash.name}（${site.headClash.englishName}）｜${site.name}`}
  description={site.headClash.description}
  ogImage="/head-clash/hero.jpg"
  ogWidth={1536}
  ogHeight={1024}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: site.headClash.name,
    alternateName: site.headClash.englishName,
    description: site.headClash.description,
    url: new URL(site.headClash.path, site.url),
    image: new URL('/head-clash/icon.jpg', site.url),
    gamePlatform: ['iOS', 'Android'],
    operatingSystem: ['iOS', 'Android'],
    author: { '@type': 'Organization', name: site.name },
  }}
>
  <div id="top" class="hc-page">
    <Header context="game" />

    <main id="main">
      <section class="hc-hero" aria-labelledby="hc-title">
        <div class="shell hc-hero-grid">
          <div class="hc-hero-copy">
            <div class="hc-lockup">
              <img src="/head-clash/icon.jpg" alt="飞头大战游戏图标" width="80" height="80" />
              <div><span>HOTARU STUDIO PRESENTS</span><strong>HEAD CLASH</strong></div>
            </div>
            <p class="hc-eyebrow">PORTRAIT PHYSICS BATTLE · 1V1</p>
            <h1 id="hc-title">飞头<br /><em>大战</em><span aria-hidden="true">!</span></h1>
            <p class="hc-hero-lede">先猜对手会往哪里走，再把头甩出去。<br />在同一回合里锁定行动，让碰撞替你揭晓答案。</p>
            <div class="hc-hero-actions">
              <a class="hc-button" href="#how-to-play">了解玩法 <span aria-hidden="true">↘</span></a>
              <span class="hc-status"><i aria-hidden="true"></i>{site.headClash.status}</span>
            </div>
            <p class="hc-hero-foot">面向 iOS / Android 开发 · 目前暂无公开下载</p>
          </div>

          <figure class="hc-hero-art">
            <div class="hc-art-top"><span>HEAD CLASH / 001</span><span>同步锁定 · 公平出击</span></div>
            <img src="/head-clash/hero.jpg" alt="飞头大战标题插画：两名角色在海岛擂台上伸长脖子，以头部相撞" width="1536" height="1024" />
            <figcaption>游戏标题插画 <span>↗</span></figcaption>
          </figure>
        </div>
        <div class="hc-hero-index" aria-hidden="true"><span>01 / GAME</span><span>SCROLL TO EXPLORE ↓</span></div>
      </section>

      <div class="hc-rule-strip" aria-label="玩法流程">
        <div class="shell"><span>秘密走位</span><b>→</b><span>同步移动</span><b>→</b><span>锁定攻击</span><b>→</b><span>同时出击</span></div>
      </div>

      <section id="how-to-play" class="hc-section hc-mechanics" aria-labelledby="hc-mechanics-title">
        <div class="shell hc-section-intro">
          <p class="hc-index">01 / THE RULES</p>
          <div>
            <h2 id="hc-mechanics-title">不是谁先出手，<br /><em>而是谁看得更准。</em></h2>
            <p>《飞头大战》是一款竖屏同步回合制物理对战游戏。双方先各自选择走位，再根据移动后的局面选择攻击方向；锁定之后，两个头部同时弹射。</p>
          </div>
        </div>
        <div class="shell hc-mechanic-grid">
          <article>
            <span>01 / READ</span>
            <div class="hc-card-symbol" aria-hidden="true">↗</div>
            <h3>秘密走位</h3>
            <p>预判对方下一步。两人都选定后，位置才会一起改变。</p>
          </article>
          <article>
            <span>02 / BOUNCE</span>
            <div class="hc-card-symbol" aria-hidden="true">⤴</div>
            <h3>借力反弹</h3>
            <p>利用石柱和边墙改变轨迹，绕开正面防护寻找角度。</p>
          </article>
          <article>
            <span>03 / HIT</span>
            <div class="hc-card-symbol" aria-hidden="true">✳</div>
            <h3>瞄准身体</h3>
            <p>脖子会挡住攻击；只有击中身体才能造成伤害。将对手撞出擂台或使其生命值归零即可获胜。</p>
          </article>
        </div>
      </section>

      <section class="hc-screens" aria-labelledby="hc-screens-title">
        <div class="shell hc-screens-grid">
          <div class="hc-screens-copy">
            <p class="hc-index">02 / IN THE ARENA</p>
            <h2 id="hc-screens-title">一伸、一弹，<br /><em>胜负就在下一瞬。</em></h2>
            <p>先选位置，再选择攻击。头部、脖子、障碍物和擂台边缘让每一轮都出现新的路线。</p>
            <div class="hc-visual-facts">
              <div><strong>06</strong><span>张擂台地图</span></div>
              <div><strong>1V1</strong><span>同步回合对战</span></div>
            </div>
            <p class="hc-screenshot-note">以下为开发中版本的实际游戏界面。</p>
          </div>
          <div class="hc-phone-pair">
            <figure class="hc-phone hc-phone--battle">
              <img src="/head-clash/battle.png" alt="飞头大战实机画面：角色伸长脖子，在圆形擂台上同时攻击" width="1080" height="1920" loading="lazy" />
              <figcaption><span>01</span> 同时出击</figcaption>
            </figure>
            <figure class="hc-phone hc-phone--home">
              <img src="/head-clash/home.png" alt="飞头大战实机画面：主菜单展示角色、在线匹配与 AI 对战入口" width="1080" height="1920" loading="lazy" />
              <figcaption><span>02</span> 游戏首页</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="hc-modes" aria-labelledby="hc-modes-title">
        <div class="shell">
          <div class="hc-modes-heading">
            <p class="hc-index">03 / CHOOSE YOUR MATCH</p>
            <h2 id="hc-modes-title">自己练习，<br />或和真人过招。</h2>
          </div>
          <div class="hc-mode-grid">
            <article>
              <span>01 / SOLO</span>
              <h3>AI 对战</h3>
              <p>选择场地，与 AI 练习走位、角度和反弹路线。</p>
              <strong aria-hidden="true">↗</strong>
            </article>
            <article>
              <span>02 / ONLINE</span>
              <h3>随机 1v1</h3>
              <p>在线匹配真人对手，在同步锁定的回合中较量判断。</p>
              <strong aria-hidden="true">↗</strong>
            </article>
          </div>
          <p class="hc-language">界面语言 <span>简体中文 · 日本語 · English</span></p>
        </div>
      </section>

      <section class="hc-close" aria-labelledby="hc-close-title">
        <div class="shell hc-close-grid">
          <img src="/head-clash/icon.jpg" alt="" width="140" height="140" loading="lazy" />
          <div>
            <p class="hc-index">HEAD CLASH / IN DEVELOPMENT</p>
            <h2 id="hc-close-title">下一回合，<br />见。</h2>
            <p>《飞头大战》正在面向移动端开发，公开下载信息将在准备就绪后公布。</p>
          </div>
          <a href="/#works">返回全部作品 <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  .hc-page { overflow: hidden; color: #193b35; background: #f8f7ef; }
  .hc-page :global(.site-header) { color: #fff; }
  .hc-page :global(.site-header .header-inner) { border-color: rgba(255, 255, 255, .2); }
  .hc-page :global(.site-header .brand),
  .hc-page :global(.site-header .nav-cta) { color: #fff; }
  .hc-page :global(.site-header nav a:not(.nav-cta):hover) { color: #fbd06a; }

  .hc-hero { position: relative; min-height: 800px; padding-top: 160px; background: #173b34; color: #fffdf3; }
  .hc-hero::before { position: absolute; inset: 0; content: ''; opacity: .16; background: radial-gradient(circle at 16% 72%, #7abd9c, transparent 30%), radial-gradient(circle at 82% 10%, #fbd06a, transparent 24%); pointer-events: none; }
  .hc-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(390px, .85fr) minmax(0, 1.15fr); gap: clamp(35px, 5vw, 85px); align-items: center; padding-bottom: 104px; }
  .hc-hero-copy { padding-block: 25px; }
  .hc-lockup { display: flex; align-items: center; gap: 16px; }
  .hc-lockup img { width: 66px; height: 66px; border: 1px solid rgba(255, 255, 255, .35); border-radius: 15px; }
  .hc-lockup div { display: grid; gap: 6px; }
  .hc-lockup span, .hc-eyebrow, .hc-index, .hc-art-top, .hc-hero-index, .hc-mechanic-grid article > span, .hc-mode-grid article > span { font-size: .62rem; font-weight: 760; letter-spacing: .18em; }
  .hc-lockup span { color: #b6cfbf; }
  .hc-lockup strong { font-size: .9rem; letter-spacing: .11em; }
  .hc-eyebrow { margin-top: 76px; color: #fbd06a; }
  .hc-hero h1 { margin-top: 20px; font-size: clamp(5.8rem, 10vw, 10rem); font-weight: 780; line-height: .82; letter-spacing: -.09em; }
  .hc-hero h1 em { color: #fbd06a; font-style: normal; }
  .hc-hero h1 span { display: inline-block; margin-left: .07em; color: #f28a65; transform: rotate(11deg); }
  .hc-hero-lede { margin-top: 34px; color: #d5e2d8; font-size: clamp(.96rem, 1.3vw, 1.15rem); line-height: 1.9; }
  .hc-hero-actions { display: flex; flex-wrap: wrap; gap: 23px; align-items: center; margin-top: 43px; }
  .hc-button { display: inline-flex; min-width: 170px; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 19px; color: #183a33; background: #fbd06a; font-size: .79rem; font-weight: 800; transition: transform .18s ease, background .18s ease; }
  .hc-button:hover { background: #ffe29a; transform: translateY(-2px); }
  .hc-button span { font-size: 1.1rem; }
  .hc-status { display: inline-flex; align-items: center; gap: 9px; color: #d8e8dc; font-size: .74rem; font-weight: 700; }
  .hc-status i { width: 7px; height: 7px; border-radius: 50%; background: #fbd06a; box-shadow: 0 0 0 5px rgba(251, 208, 106, .13); }
  .hc-hero-foot { margin-top: 25px; color: #a9c1b2; font-size: .7rem; }
  .hc-hero-art { position: relative; padding: 17px; background: #fbfaf2; box-shadow: 20px 24px 0 rgba(4, 24, 18, .28); transform: rotate(1.4deg); }
  .hc-art-top { display: flex; justify-content: space-between; gap: 12px; padding: 3px 3px 16px; color: #315248; }
  .hc-hero-art img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .hc-hero-art figcaption { display: flex; justify-content: space-between; padding: 13px 3px 1px; color: #315248; font-size: .66rem; font-weight: 750; letter-spacing: .1em; }
  .hc-hero-index { position: absolute; right: max(32px, calc((100vw - 1240px) / 2)); bottom: 27px; left: max(32px, calc((100vw - 1240px) / 2)); display: flex; justify-content: space-between; color: #b1c8b8; }

  .hc-rule-strip { border-bottom: 1px solid #d5d9c9; background: #e8eddc; }
  .hc-rule-strip .shell { display: flex; min-height: 77px; align-items: center; justify-content: space-between; gap: 14px; color: #234c40; font-size: .78rem; font-weight: 760; letter-spacing: .05em; }
  .hc-rule-strip b { color: #cf7855; font-size: 1.2rem; }

  .hc-section { padding-block: 120px 130px; }
  .hc-section-intro { display: grid; grid-template-columns: .35fr 1fr; gap: 55px; }
  .hc-index { color: #a95d43; }
  .hc-section-intro h2, .hc-screens h2, .hc-modes h2, .hc-close h2 { font-size: clamp(2.8rem, 5.4vw, 5.5rem); font-weight: 760; line-height: 1.12; letter-spacing: -.075em; }
  .hc-section-intro h2 em, .hc-screens h2 em { color: #b66a50; font-style: normal; }
  .hc-section-intro > div > p, .hc-screens-copy > p:not(.hc-index):not(.hc-screenshot-note) { max-width: 650px; margin-top: 28px; color: #64746d; font-size: .98rem; line-height: 1.95; }
  .hc-mechanic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 80px; border: 1px solid #dce2d5; background: #dce2d5; }
  .hc-mechanic-grid article { display: flex; min-height: 330px; flex-direction: column; padding: 32px; background: #fffef7; }
  .hc-mechanic-grid article > span { color: #af7259; }
  .hc-card-symbol { margin: 16px 0 auto; color: #d88561; font-size: 3.5rem; line-height: 1; }
  .hc-mechanic-grid h3 { font-size: 1.48rem; letter-spacing: -.04em; }
  .hc-mechanic-grid p { max-width: 30ch; margin-top: 11px; color: #6b7971; font-size: .83rem; line-height: 1.8; }

  .hc-screens { padding-block: 115px; background: #dbe8dc; }
  .hc-screens-grid { display: grid; grid-template-columns: minmax(290px, .75fr) minmax(0, 1.25fr); gap: clamp(55px, 8vw, 145px); align-items: center; }
  .hc-screens h2 { margin-top: 29px; }
  .hc-visual-facts { display: flex; gap: 38px; margin-top: 47px; padding-top: 25px; border-top: 1px solid #b7cdbd; }
  .hc-visual-facts div { display: grid; gap: 6px; }
  .hc-visual-facts strong { font-size: 2.2rem; line-height: 1; letter-spacing: -.05em; }
  .hc-visual-facts span { color: #557366; font-size: .71rem; font-weight: 720; }
  .hc-screenshot-note { margin-top: 37px; color: #587366; font-size: .72rem; }
  .hc-phone-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 23px; align-items: start; }
  .hc-phone { min-width: 0; padding: 10px 10px 16px; border: 1px solid #bfd0bc; border-radius: 23px; background: #fbfaf2; box-shadow: 13px 17px 0 rgba(30, 71, 54, .1); }
  .hc-phone--home { margin-top: 60px; }
  .hc-phone img { width: 100%; height: auto; border-radius: 14px; }
  .hc-phone figcaption { display: flex; gap: 10px; padding: 15px 9px 2px; color: #4b695a; font-size: .72rem; font-weight: 760; }
  .hc-phone figcaption span { color: #bd7051; }

  .hc-modes { padding-block: 120px 110px; color: #fbf9ed; background: #193c34; }
  .hc-modes .hc-index { color: #fbd06a; }
  .hc-modes h2 { margin-top: 22px; }
  .hc-mode-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin-top: 65px; border: 1px solid #557369; background: #557369; }
  .hc-mode-grid article { position: relative; min-height: 265px; padding: 32px; background: #224a40; }
  .hc-mode-grid article > span { color: #fbd06a; }
  .hc-mode-grid h3 { margin-top: 44px; font-size: 2rem; letter-spacing: -.055em; }
  .hc-mode-grid p { max-width: 39ch; margin-top: 13px; color: #bfd5c7; font-size: .85rem; line-height: 1.8; }
  .hc-mode-grid strong { position: absolute; top: 29px; right: 32px; color: #b3d2bd; font-size: 1.25rem; }
  .hc-language { display: flex; justify-content: space-between; gap: 20px; margin-top: 32px; padding-top: 20px; border-top: 1px solid #557369; color: #a5c8b5; font-size: .74rem; }
  .hc-language span { color: #fffdf3; }

  .hc-close { padding-block: 105px; background: #fbdc8b; }
  .hc-close-grid { display: grid; grid-template-columns: 140px 1fr auto; gap: clamp(28px, 5vw, 75px); align-items: center; }
  .hc-close-grid > img { width: 140px; height: 140px; border-radius: 23px; }
  .hc-close h2 { margin-top: 14px; }
  .hc-close-grid > div > p:last-child { max-width: 480px; margin-top: 15px; color: #576a5d; font-size: .85rem; line-height: 1.8; }
  .hc-close-grid > a { align-self: end; display: flex; min-width: 180px; justify-content: space-between; gap: 12px; padding-bottom: 10px; border-bottom: 1px solid #29463b; color: #29463b; font-size: .8rem; font-weight: 780; }
  .hc-close-grid > a:hover { color: #a44d36; border-color: #a44d36; }

  @media (max-width: 1040px) {
    .hc-hero-grid { grid-template-columns: minmax(320px, .9fr) minmax(0, 1.1fr); gap: 30px; }
    .hc-hero h1 { font-size: clamp(5.8rem, 10vw, 8rem); }
    .hc-eyebrow { margin-top: 55px; }
    .hc-screens-grid { gap: 55px; }
    .hc-mechanic-grid article { padding: 25px; }
  }

  @media (max-width: 800px) {
    .hc-hero { padding-top: 140px; }
    .hc-hero-grid { grid-template-columns: 1fr; padding-bottom: 100px; }
    .hc-hero-copy { padding-block: 0; }
    .hc-eyebrow { margin-top: 55px; }
    .hc-hero h1 { font-size: clamp(6.5rem, 17vw, 10rem); }
    .hc-hero-art { max-width: 690px; margin: 0 auto; }
    .hc-section-intro { grid-template-columns: 1fr; gap: 18px; }
    .hc-screens-grid { grid-template-columns: 1fr; }
    .hc-screens-copy { max-width: 630px; }
    .hc-phone-pair { max-width: 660px; }
    .hc-close-grid { grid-template-columns: 110px 1fr; }
    .hc-close-grid > img { width: 110px; height: 110px; }
    .hc-close-grid > a { grid-column: 2; justify-self: start; }
  }

  @media (max-width: 620px) {
    .hc-hero { padding-top: 130px; }
    .hc-hero-grid { padding-bottom: 90px; }
    .hc-lockup img { width: 56px; height: 56px; }
    .hc-eyebrow { margin-top: 48px; }
    .hc-hero h1 { font-size: clamp(5.8rem, 22vw, 8rem); }
    .hc-hero-lede br { display: none; }
    .hc-hero-art { padding: 10px; box-shadow: 10px 12px 0 rgba(4, 24, 18, .28); }
    .hc-art-top { font-size: .46rem; }
    .hc-hero-index { right: 18px; left: 18px; font-size: .48rem; }
    .hc-rule-strip .shell { flex-wrap: wrap; justify-content: center; gap: 7px 12px; padding-block: 20px; font-size: .65rem; }
    .hc-section { padding-block: 80px 85px; }
    .hc-section-intro h2, .hc-screens h2, .hc-modes h2, .hc-close h2 { font-size: clamp(2.5rem, 10vw, 4rem); }
    .hc-mechanic-grid { grid-template-columns: 1fr; margin-top: 48px; }
    .hc-mechanic-grid article { min-height: 230px; }
    .hc-card-symbol { margin: 11px 0 auto; font-size: 2.6rem; }
    .hc-screens, .hc-modes { padding-block: 82px; }
    .hc-phone-pair { gap: 12px; }
    .hc-phone { padding: 6px 6px 10px; border-radius: 15px; box-shadow: 6px 8px 0 rgba(30, 71, 54, .1); }
    .hc-phone--home { margin-top: 35px; }
    .hc-phone img { border-radius: 9px; }
    .hc-phone figcaption { padding: 11px 4px 1px; font-size: .58rem; }
    .hc-mode-grid { grid-template-columns: 1fr; margin-top: 42px; }
    .hc-mode-grid article { min-height: 205px; }
    .hc-mode-grid h3 { margin-top: 28px; }
    .hc-language { flex-direction: column; gap: 8px; }
    .hc-close { padding-block: 75px; }
    .hc-close-grid { grid-template-columns: 76px 1fr; gap: 18px; }
    .hc-close-grid > img { width: 76px; height: 76px; border-radius: 15px; }
    .hc-close-grid > a { grid-column: 1 / -1; margin-top: 10px; }
  }
</style>
