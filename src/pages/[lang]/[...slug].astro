---
import HeadClashPage from '../projects/head-clash/index.astro';
import GemWarriorPage from '../projects/gem-warrior/index.astro';
import FxTradePage from '../projects/fxtrade/index.astro';
import PrivacyHubPage from '../privacy/index.astro';
import HeadClashPrivacyPage from '../privacy/head-clash/index.astro';
import GemWarriorPrivacyPage from '../privacy/gem-warrior/index.astro';
import PocketStrikerPrivacyPage from '../privacy/pocket-striker/index.astro';
import FxTradePrivacyPage from '../privacy/fxtrade/index.astro';

export function getStaticPaths() {
  const slugs = [
    'projects/head-clash',
    'projects/gem-warrior',
    'projects/fxtrade',
    'privacy',
    'privacy/head-clash',
    'privacy/gem-warrior',
    'privacy/pocket-striker',
    'privacy/fxtrade',
  ];
  return ['ja', 'en'].flatMap((lang) => slugs.map((slug) => ({ params: { lang, slug } })));
}

const slug = Astro.params.slug;
---

{slug === 'projects/head-clash' && <HeadClashPage />}
{slug === 'projects/gem-warrior' && <GemWarriorPage />}
{slug === 'projects/fxtrade' && <FxTradePage />}
{slug === 'privacy' && <PrivacyHubPage />}
{slug === 'privacy/head-clash' && <HeadClashPrivacyPage />}
{slug === 'privacy/gem-warrior' && <GemWarriorPrivacyPage />}
{slug === 'privacy/pocket-striker' && <PocketStrikerPrivacyPage />}
{slug === 'privacy/fxtrade' && <FxTradePrivacyPage />}
