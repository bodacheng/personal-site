---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../config/site';
---

<BaseLayout>
  <div id="top" class="portfolio-home">
    <Header context="home" />

    <main id="main">
      <section class="portfolio-intro" aria-labelledby="portfolio-title">
        <div class="portfolio-intro-lines" aria-hidden="true"></div>
        <div class="shell portfolio-intro-inner">
          <p class="portfolio-eyebrow">INDEPENDENT DEVELOPMENT · TOKYO</p>
          <h1 id="portfolio-title"><span>HOTARU</span><span>STUDIO</span></h1>
          <div class="portfolio-intro-bottom">
            <p>独立开发游戏与实用应用。每个项目围绕自己的用户、目的和使用场景，采用完全独立的产品语言。</p>
            <nav class="portfolio-jump" aria-label="选择作品类别">
              <a href="#head-clash-project"><span>01</span><strong>游戏</strong><small>GAME</small></a>
              <a href="#fx-project"><span>02</span><strong>应用</strong><small>APPLICATION</small></a>
            </nav>
          </div>
        </div>
      </section>

      <section id="works" class="portfolio-index" aria-labelledby="works-title">
        <div class="shell">
          <p>SELECTED WORKS</p>
          <h2 id="works-title">作品</h2>
          <span>以下项目分别进入各自的设计世界。</span>
        </div>
      </section>

      <section id="head-clash-project" class="home-head-clash-project" aria-labelledby="home-head-clash-title">
        <div class="head-clash-project-copy">
          <div class="project-category"><span>01 / GAME</span><strong>{site.headClash.status}</strong></div>
          <div class="head-clash-title-lockup">
            <img src="/head-clash/icon.jpg" alt="飞头大战游戏图标" width="1024" height="1024" />
            <p>HEAD CLASH<br /><span>iOS · Android</span></p>
          </div>
          <p class="head-clash-product-kicker">SIMULTANEOUS PHYSICS DUEL</p>
          <h2 id="home-head-clash-title">飞头<span>大战</span></h2>
          <p class="head-clash-summary">{site.headClash.description}</p>
          <ul class="head-clash-tags" aria-label="游戏特色">
            <li>同步规划与出击</li>
            <li>反弹路线博弈</li>
            <li>AI · 在线 1 对 1</li>
          </ul>
          <a class="head-clash-detail-link" href={site.headClash.path}>了解这款游戏 <span aria-hidden="true">→</span></a>
          <p class="head-clash-availability">移动端开发中，尚未开放公开下载。</p>
        </div>
        <div class="head-clash-project-visual">
          <img class="head-clash-hero-art" src="/head-clash/hero.jpg" alt="飞头大战的两名角色在海岛擂台上伸长脖子相撞的插画" width="1536" height="1024" />
          <figure class="head-clash-preview">
            <img src="/head-clash/battle.png" alt="飞头大战实际游戏画面：双方在圆形擂台同时出击" width="1080" height="1920" loading="lazy" />
            <figcaption>ACTUAL GAMEPLAY</figcaption>
          </figure>
        </div>
      </section>

      <section id="game-project" class="home-game-project" aria-labelledby="home-game-title">
        <div class="game-project-visual">
          <img src="/game/battle-03.png" alt="魔晶闘士角色在竞技场中进行物理格斗" width="1600" height="900" />
          <div class="game-visual-label"><span>PHYSICS FIGHTING</span><strong>GEM WARRIOR</strong></div>
        </div>
        <div class="game-project-copy">
          <div class="project-category"><span>02 / GAME</span><strong>现已上线</strong></div>
          <div class="game-title-lockup">
            <img src="/game/app-icon.jpg" alt="魔晶闘士游戏图标" width="96" height="96" />
            <p>iOS · Android</p>
          </div>
          <h2 id="home-game-title">魔晶闘士<br /><em>無限格闘戦争</em></h2>
          <p>{site.game.description}</p>
          <ul class="game-project-tags" aria-label="游戏特点">
            <li>技能宝石构筑</li>
            <li>真实物理碰撞</li>
            <li>竞技场 PvP</li>
          </ul>
          <div class="project-primary-actions">
            <a class="game-detail-link" href={site.game.path}>进入游戏项目页 <span>→</span></a>
            <a href={site.game.privacyPath}>隐私政策</a>
          </div>
          <div class="home-store-links" aria-label="下载游戏">
            <a href={site.game.iosUrl} target="_blank" rel="noreferrer"><img src="/game/app-store-badge.svg" alt="从 App Store 下载" /></a>
            <a href={site.game.androidUrl} target="_blank" rel="noreferrer"><img src="/game/google-play-badge.png" alt="从 Google Play 下载" /></a>
          </div>
        </div>
      </section>

      <div class="project-separator" aria-hidden="true"><span>END / GAME</span><span>NEXT / APPLICATION</span></div>

      <section id="fx-project" class="home-fx-project" aria-labelledby="home-fx-title">
        <div class="shell home-fx-inner">
          <div class="fx-project-copy">
            <div class="project-category"><span>03 / APPLICATION</span><strong>准备上线</strong></div>
            <div class="fx-title-lockup">
              <img src="/fxtrade/app-icon.png" alt="USD/JPY Advice 应用图标" width="96" height="96" />
              <p>FXTRADE PROJECT<br /><span>FOR iOS</span></p>
            </div>
            <p class="fx-product-kicker">USD/JPY DECISION SUPPORT</p>
            <h2 id="home-fx-title">USD/JPY<br /><em>Advice</em></h2>
            <p>{site.fxtrade.description}</p>
            <dl class="fx-project-data">
              <div><dt>MARKET</dt><dd>USD / JPY</dd></div>
              <div><dt>INDICATORS</dt><dd>Trend · RSI · ATR</dd></div>
              <div><dt>LANGUAGE</dt><dd>日本語 · English · 简体中文</dd></div>
            </dl>
            <div class="project-primary-actions project-primary-actions--fx">
              <a class="fx-detail-link" href={site.fxtrade.path}>进入应用项目页 <span>→</span></a>
              <a href={site.fxtrade.privacyPath}>隐私政策</a>
            </div>
            <p class="fx-project-note">信息与决策辅助工具 · 不连接券商账户 · 不代替用户交易</p>
          </div>

          <div class="fx-project-visual" aria-label="USD/JPY Advice 应用界面">
            <div class="fx-visual-grid" aria-hidden="true"></div>
            <figure class="fx-home-phone fx-home-phone--overview">
              <img src="/fxtrade/screen-overview-zh.png" alt="USD/JPY 实时行情与技术指标界面" width="1242" height="2688" loading="lazy" />
            </figure>
            <figure class="fx-home-phone fx-home-phone--advice">
              <img src="/fxtrade/screen-advice-zh.png" alt="AI 交易建议与风险信息界面" width="1242" height="2688" loading="lazy" />
            </figure>
            <div class="fx-visual-caption"><span>REAL-TIME</span><strong>RATE · CHART · RISK</strong></div>
          </div>
        </div>
      </section>

      <section id="studio" class="portfolio-about" aria-labelledby="about-title">
        <div class="shell portfolio-about-inner">
          <p>04 / STUDIO</p>
          <div>
            <h2 id="about-title">独立完成，<br />长期维护。</h2>
            <p>HOTARU STUDIO 负责从原型、视觉和开发到发布后的维护。不同类别的项目保持各自的目标与设计体系，同时共享对可用性、透明说明和隐私保护的基本要求。</p>
          </div>
          <dl>
            <div><dt>BASE</dt><dd>Tokyo, Japan</dd></div>
            <div><dt>PLATFORMS</dt><dd>iOS · Android</dd></div>
            <div><dt>CONTACT</dt><dd><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></dd></div>
          </dl>
        </div>
      </section>

      <section id="contact" class="portfolio-contact" aria-labelledby="contact-title">
        <div class="shell">
          <p>CONTACT</p>
          <h2 id="contact-title">项目咨询与支持</h2>
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail} <span>↗</span></a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
