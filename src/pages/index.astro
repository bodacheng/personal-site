---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../config/site';
---

<BaseLayout>
  <div id="top" class="studio-home">
    <Header context="home" />

    <main id="main">
      <section class="studio-hero" aria-labelledby="studio-title">
        <div class="studio-grid" aria-hidden="true"></div>
        <div class="shell studio-hero-inner">
          <div class="studio-hero-copy">
            <p class="studio-kicker">HOTARU STUDIO · TOKYO</p>
            <h1 id="studio-title">把复杂的系统，<br /><em>做成可以直接使用的产品。</em></h1>
            <p>我们独立设计和开发游戏与应用。从真实物理驱动的格斗体验，到整理外汇判断信息的 AI 工具，每件作品都从“怎样让人更容易理解和行动”开始。</p>
            <a class="text-link" href="#works">查看作品 <span aria-hidden="true">↓</span></a>
          </div>

          <div class="studio-hero-montage" aria-label="HOTARU STUDIO 作品预览">
            <figure class="montage-game">
              <img src="/game/battle-03.png" alt="魔晶闘士游戏战斗画面" width="1600" height="900" />
              <figcaption>PHYSICS FIGHTING</figcaption>
            </figure>
            <figure class="montage-fx">
              <img src="/fxtrade/screen-overview-zh.png" alt="USD/JPY Advice 应用界面" width="1242" height="2688" />
              <figcaption>AI DECISION SUPPORT</figcaption>
            </figure>
            <span class="montage-index">02<br /><small>PRODUCTS</small></span>
          </div>
        </div>
      </section>

      <section class="studio-statement" aria-label="工作室方向">
        <div class="shell">
          <p>INDEPENDENT BY DESIGN</p>
          <strong>游戏的爽快感，需要精密系统。<br />决策的清晰度，也一样。</strong>
        </div>
      </section>

      <section id="works" class="works" aria-labelledby="works-title">
        <div class="shell">
          <div class="studio-section-heading">
            <p>01 / SELECTED WORKS</p>
            <div>
              <h2 id="works-title">当前作品</h2>
              <span>一个已经上线，一个正在准备。</span>
            </div>
          </div>

          <article class="work work--game">
            <a class="work-media" href={site.game.path} aria-label={`查看 ${site.game.name}`}>
              <img src="/game/battle-07.webp" alt="三名玩家在竞技场迎战敌人" width="1600" height="740" loading="lazy" />
              <span class="work-number">01</span>
            </a>
            <div class="work-copy">
              <div class="work-meta"><span>GAME · iOS / ANDROID</span><strong class="status-live">现已上线</strong></div>
              <img class="work-icon" src="/game/app-icon.jpg" alt="" width="88" height="88" loading="lazy" />
              <p class="work-overline">GEM WARRIOR</p>
              <h3>{site.game.name}</h3>
              <p>{site.game.description}</p>
              <div class="work-actions">
                <a href={site.game.path}>项目详情 <span>→</span></a>
                <a href={site.game.privacyPath}>隐私政策</a>
              </div>
            </div>
          </article>

          <article class="work work--fx">
            <div class="work-copy">
              <div class="work-meta"><span>FINANCE TOOL · iOS</span><strong class="status-soon">准备上线</strong></div>
              <img class="work-icon" src="/fxtrade/app-icon.png" alt="" width="88" height="88" loading="lazy" />
              <p class="work-overline">FXTRADE PROJECT</p>
              <h3>{site.fxtrade.name}</h3>
              <p>{site.fxtrade.description}</p>
              <div class="work-actions">
                <a href={site.fxtrade.path}>项目详情 <span>→</span></a>
                <a href={site.fxtrade.privacyPath}>隐私政策</a>
              </div>
            </div>
            <a class="work-media work-media--phone" href={site.fxtrade.path} aria-label={`查看 ${site.fxtrade.name}`}>
              <div class="fx-panel-copy" aria-hidden="true">
                <span>USD / JPY</span>
                <strong>REAL-TIME<br />DECISION SUPPORT</strong>
                <small>TREND · RSI · ATR · RISK</small>
              </div>
              <img src="/fxtrade/screen-overview-zh.png" alt="USD/JPY Advice 实时行情与分析界面" width="1242" height="2688" loading="lazy" />
              <span class="work-number">02</span>
            </a>
          </article>
        </div>
      </section>

      <section id="studio" class="studio-about" aria-labelledby="about-title">
        <div class="shell about-grid">
          <p class="studio-section-index">02 / THE STUDIO</p>
          <div>
            <h2 id="about-title">从原型到上线，<br />把产品完整地做出来。</h2>
            <p>HOTARU STUDIO 是一个独立产品工作室。我们关注交互、视觉与底层逻辑之间是否真正连贯，也重视隐私、风险说明和长期维护这些不在主画面里的细节。</p>
          </div>
          <dl>
            <div><dt>FOCUS</dt><dd>Games & useful apps</dd></div>
            <div><dt>PLATFORM</dt><dd>iOS · Android</dd></div>
            <div><dt>BASED IN</dt><dd>Tokyo, Japan</dd></div>
          </dl>
        </div>
      </section>

      <section id="contact" class="studio-contact" aria-labelledby="contact-title">
        <div class="shell contact-inner">
          <p>03 / CONTACT</p>
          <h2 id="contact-title">有问题或合作想法？<br /><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></h2>
          <span>我们会通过电子邮件回复。</span>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
