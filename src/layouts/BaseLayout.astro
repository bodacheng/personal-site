---
import '../styles/global.css';
import { site } from '../config/site';
import { commonCopy, htmlLanguages, localeFromPath, localizedPath, locales, unlocalizedPath } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  ogImage?: string;
  ogWidth?: number;
  ogHeight?: number;
  structuredData?: Record<string, unknown>;
  alternateLanguages?: boolean;
}

const locale = localeFromPath(Astro.url.pathname);
const labels = commonCopy[locale];
const {
  title = `${site.name}｜${labels.siteTitle}`,
  description = labels.siteDescription,
  lang = htmlLanguages[locale],
  ogImage = '/og.png',
  ogWidth = 1200,
  ogHeight = 630,
  alternateLanguages = true,
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    legalName: site.legalName,
    description: labels.siteDescription,
    url: site.url,
    email: site.contactEmail,
  },
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(ogImage, site.url);
const basePath = unlocalizedPath(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080a10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternateLanguages && locales.map((alternateLocale) => (
      <link rel="alternate" hreflang={htmlLanguages[alternateLocale]} href={new URL(localizedPath(basePath, alternateLocale), site.url)} />
    ))}
    {alternateLanguages && <link rel="alternate" hreflang="x-default" href={new URL(basePath, site.url)} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta name="twitter:card" content="summary_large_image" />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{labels.skip}</a>
    <slot />
  </body>
</html>
