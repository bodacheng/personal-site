---
import { site } from '../config/site';

interface Props {
  context?: 'home' | 'game' | 'fxtrade' | 'privacy';
}

const { context = 'home' } = Astro.props;
const isHome = context === 'home';
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand studio-brand" href="/" aria-label={`${site.name} 首页`}>
      <span class="studio-mark" aria-hidden="true">H<span>S</span></span>
      <span>
        <strong>{site.name}</strong>
        <small>INDEPENDENT PRODUCTS</small>
      </span>
    </a>

    <nav aria-label="主要导航">
      {isHome ? (
        <>
          <a href="#game-project">游戏</a>
          <a href="#fx-project">应用</a>
        </>
      ) : (
        <a href="/#works">全部作品</a>
      )}
      <a href={isHome ? '#studio' : '/#studio'}>工作室</a>
      <a href="/privacy/">隐私政策</a>
      <a class="nav-cta" href={isHome ? '#contact' : '/#contact'}>联系</a>
    </nav>
  </div>
</header>
