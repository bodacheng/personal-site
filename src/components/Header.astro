---
import { site } from '../config/site';
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="#top" aria-label={`${site.name} 首页`}>
      <img src="/game/app-icon.jpg" alt="" width="48" height="48" />
      <span>
        <strong>{site.shortName}</strong>
        <small>{site.developer}</small>
      </span>
    </a>

    <nav aria-label="主要导航">
      <a href="#gameplay">玩法</a>
      <a href="#gallery">战斗画面</a>
      <a class="nav-cta" href="#download">免费下载</a>
    </nav>
  </div>
</header>
