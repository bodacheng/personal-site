    heroImageAlt: 'A fighter uses a series of kicks against an enemy',
    hits: 'HITS',
    build: 'BUILD',
    overviewLabel: 'Game highlights',
    overview: ['Physics based combat', 'Skill gem builds', 'Arena PvP', 'iOS / Android'],
    buildIndex: '01 / BUILD YOUR FIGHTER',
    buildTitleLine1: 'Build your skills.',
    buildTitleLine2: 'Set your rhythm.',
    buildIntro: 'Choose the range, attribute, effect, and order of every move. Slot skill gems into a combo and start winning before the fight begins.',
    buildImageAlt: 'Skill gem and combo configuration screen',
    comboLab: 'COMBO LAB',
    buildCaption: 'Every gem changes what happens on the next hit.',
    buildStatsLabel: 'Build options',
    stats: [
      { label: 'RANGE', value: 'Close · Mid · Long', text: 'Assign skills by attack range to keep your combos flowing.' },
      { label: 'STYLE', value: 'Make it yours', text: 'Mix active skills with special effects to create your own approach.' },
      { label: 'TIMING', value: 'A split second matters', text: 'Find an opening and unleash the right combo at the right moment.' },
    ],
