    galleryIntro: 'From one on one duels to multiplayer brawls, adapt your tactics to different arenas and enemy combinations.',
    galleryImageAlts: ['Three players face a lava enemy in a space arena', 'Players duel in a circular arena', 'Gem Warrior title screen'],
    galleryLabels: ['TEAM BATTLE', 'ARENA', 'MUGEN COMBAT'],
    galleryCaptions: ['Fight together', 'PvP duel', 'Endless combat'],
    featuresIndex: '04 / FEATURES',
    featuresTitle: 'Five ways to enjoy one endless war.',
    features: [
      { number: '01', title: 'Build your own fighting style', text: 'Combine skill gems with different ranges, attributes, and effects to create combos for each fighter.' },
      { number: '02', title: 'Easy controls, deep strategy', text: 'Skill placement and release timing decide the winner. Easy to pick up, rewarding to master.' },
      { number: '03', title: 'Physics driven impact', text: 'Every collision, launch, and arena interaction is powered by physics for a more immediate feel.' },
      { number: '04', title: 'Varied arenas and challenges', text: 'Face different enemies, hazards, and bosses, then adapt your lineup as the battlefield changes.' },
      { number: '05', title: 'Arena PvP', text: 'Test your reactions and tactics against other players and put your build to the test.' },
    ],
    downloadIndex: 'THE FIGHT STARTS NOW',
    downloadTitleLine1: 'Join the',
    downloadTitleLine2: 'endless fight.',
    downloadIntro: 'Download for free. Choose your fighter, combine skill gems, and launch opponents out of the arena with physics powered moves.',
  },
} as const;

const locale = localeFromPath(Astro.url.pathname);
const t = copy[locale];

const storeLinks = [
  {
    href: site.game.iosUrl,
    label: t.appStoreLabel,
    image: '/game/app-store-badge.svg',
    className: 'store-badge store-badge--apple',
  },
  {
    href: site.game.androidUrl,
    label: t.googlePlayLabel,
    image: '/game/google-play-badge.png',
    className: 'store-badge store-badge--google',
  },
];
---

<BaseLayout
  title={t.pageTitle}
  description={t.description}
  lang={{ zh: 'zh-CN', ja: 'ja', en: 'en' }[locale]}
  ogImage="/og.png"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: t.gameName,
    description: t.description,
    url: new URL(localizedPath(site.game.path, locale), site.url),
    image: new URL('/game/app-icon.jpg', site.url),
    applicationCategory: 'GameApplication',
    operatingSystem: ['iOS', 'Android'],
    author: { '@type': 'Organization', name: site.name },
  }}
>
  <div id="top" class="page-grid">
    <Header context="game" />

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid-glow" aria-hidden="true"></div>
        <div class="shell hero-inner">
          <div class="hero-copy">
            <div class="game-lockup">
              <img src="/game/app-icon.jpg" alt={t.iconAlt} width="112" height="112" />
              <p>
                <span>{t.presents}</span>
                <strong>{t.lockup}</strong>
              </p>
            </div>

            <p class="hero-kicker">{t.kicker}</p>
            <h1 id="hero-title">
              <span>{t.heroTitle}</span>
              <em>{t.heroSubtitle}</em>
            </h1>
            <p class="hero-lede">{t.heroLede}</p>

            <div class="store-links" aria-label={t.downloadsLabel}>
              {storeLinks.map((store) => (
                <a href={store.href} target="_blank" rel="noreferrer" aria-label={store.label}>
                  <img class={store.className} src={store.image} alt={store.label} />
                </a>
              ))}
            </div>
            <p class="store-note"><span aria-hidden="true"></span> {t.storeNote} <a href={localizedPath(site.game.privacyPath, locale)}>{t.privacy}</a></p>
          </div>

          <div class="hero-visual" aria-label={t.heroVisualLabel}>
            <figure class="hero-screen hero-screen--main">
              <img src="/game/battle-03.png" alt={t.heroImageAlt} width="1600" height="900" />
            </figure>
            <figure class="hero-screen hero-screen--back" aria-hidden="true">
              <img src="/game/battle-02.png" alt="" width="1600" height="900" />
            </figure>
            <div class="impact-chip impact-chip--top" aria-hidden="true">
              <span>05</span>
              <strong>{t.hits}</strong>
            </div>
            <div class="impact-chip impact-chip--bottom" aria-hidden="true">
              <span>∞</span>
              <strong>{t.build}</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="combat-strip" aria-label={t.overviewLabel}>
        <div class="shell combat-strip-inner">
          {t.overview.map((item, index) => <p><span>{String(index + 1).padStart(2, '0')}</span>{item}</p>)}
        </div>
      </section>

      <section id="gameplay" class="section gameplay" aria-labelledby="gameplay-title">
        <div class="shell">
          <div class="section-heading">
            <p class="section-index">{t.buildIndex}</p>
            <div>
              <h2 id="gameplay-title">{t.buildTitleLine1}<br />{t.buildTitleLine2}</h2>
              <p>{t.buildIntro}</p>
            </div>
          </div>

          <div class="build-showcase">
            <figure class="build-screen">
              <img src="/game/battle-05.webp" alt={t.buildImageAlt} width="1600" height="740" loading="lazy" />
              <figcaption>
                <span>{t.comboLab}</span>
                <strong>{t.buildCaption}</strong>
              </figcaption>
            </figure>
            <div class="build-stats" aria-label={t.buildStatsLabel}>
              {t.stats.map((stat) => (
                <article>
                  <span>{stat.label}</span>
                  <strong>{stat.value}</strong>
                  <p>{stat.text}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section physics" aria-labelledby="physics-title">
        <div class="shell physics-grid">
          <div class="physics-copy">
            <p class="section-index">{t.physicsIndex}</p>
            <h2 id="physics-title">{t.physicsTitle}</h2>
            <p>{t.physicsIntro}</p>
            <ul>
              {t.physicsList.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>)}
            </ul>
          </div>
          <figure class="physics-screen">
            <img src="/game/battle-04.png" alt={t.physicsImageAlt} width="1600" height="900" loading="lazy" />
          </figure>
        </div>
      </section>

      <section id="gallery" class="section gallery" aria-labelledby="gallery-title">
        <div class="shell">
          <div class="gallery-heading">
            <div>
              <p class="section-index">{t.galleryIndex}</p>
              <h2 id="gallery-title">{t.galleryTitle}</h2>
            </div>
            <p>{t.galleryIntro}</p>
          </div>

          <div class="gallery-grid">
            <figure class="gallery-card gallery-card--wide">
              <img src="/game/battle-07.webp" alt={t.galleryImageAlts[0]} width="1600" height="740" loading="lazy" />
              <figcaption><span>{t.galleryLabels[0]}</span><strong>{t.galleryCaptions[0]}</strong></figcaption>
            </figure>
            <figure class="gallery-card">
              <img src="/game/battle-06.webp" alt={t.galleryImageAlts[1]} width="1600" height="740" loading="lazy" />
              <figcaption><span>{t.galleryLabels[1]}</span><strong>{t.galleryCaptions[1]}</strong></figcaption>
            </figure>
            <figure class="gallery-card">
              <img src="/game/battle-01.png" alt={t.galleryImageAlts[2]} width="1600" height="900" loading="lazy" />
              <figcaption><span>{t.galleryLabels[2]}</span><strong>{t.galleryCaptions[2]}</strong></figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="features" aria-labelledby="features-title">
        <div class="shell">
          <div class="features-title-row">
            <p class="section-index">{t.featuresIndex}</p>
            <h2 id="features-title">{t.featuresTitle}</h2>
          </div>
          <div class="feature-grid">
            {t.features.map((feature) => (
              <article>
                <span>{feature.number}</span>
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="download" class="download" aria-labelledby="download-title">
        <div class="download-backdrop" aria-hidden="true"></div>
        <div class="shell download-inner">
          <img class="download-icon" src="/game/app-icon.jpg" alt={t.iconAlt} width="152" height="152" loading="lazy" />
          <p class="section-index">{t.downloadIndex}</p>
          <h2 id="download-title">{t.downloadTitleLine1}<br />{t.downloadTitleLine2}</h2>
          <p>{t.downloadIntro}</p>
          <div class="store-links store-links--center" aria-label={t.downloadsLabel}>
            {storeLinks.map((store) => (
              <a href={store.href} target="_blank" rel="noreferrer" aria-label={store.label}>
                <img class={store.className} src={store.image} alt={store.label} />
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
