    iconAlt: 'Gem Warrior game icon',
    presents: 'HOTARU STUDIO PRESENTS',
    lockup: 'PHYSICS FIGHTING × SKILL BUILDS',
    kicker: 'GEM WARRIOR · MUGEN COMBAT WAR',
    heroTitle: 'GEM WARRIOR',
    heroSubtitle: 'MUGEN COMBAT WAR',
    heroLede: 'Combine skill gems to create combos that are uniquely yours. Feel the physics behind every hit and launch your opponents across a constantly changing battlefield.',
    downloadsLabel: 'Download the game',
    appStoreLabel: 'Download on the App Store',
    googlePlayLabel: 'Get it on Google Play',
    storeNote: 'Free to play · Contains ads and in-app purchases ·',
