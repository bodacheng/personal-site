  en: {
    name: 'Head Clash',
    description: 'Pick your move, then launch your heads at the same time. Bounce off pillars and walls, get around neck defenses, and hit your opponent’s body in a simultaneous turn based physics duel.',
    status: 'In development',
    iconAlt: 'Head Clash game icon',
    presents: 'HOTARU STUDIO PRESENTS',
    eyebrow: 'PORTRAIT PHYSICS BATTLE · 1V1',
    titleFirst: 'HEAD',
    titleSecond: 'CLASH',
    heroLineOne: 'Predict where your rival will move, then let your head fly.',
    heroLineTwo: 'Lock in your actions on the same turn and let the collision reveal the result.',
    learnRules: 'How to play',
    availability: 'In development for iOS / Android · No public download yet',
    simultaneous: 'SIMULTANEOUS LOCK IN · FAIR FIGHT',
    heroAlt: 'Head Clash title art showing two characters stretching their necks and colliding on an island arena',
    heroCaption: 'GAME TITLE ART',
    gameIndex: '01 / GAME',
    scroll: 'SCROLL TO EXPLORE ↓',
    flowLabel: 'How a turn works',
    flow: ['Secret move', 'Move together', 'Lock in attacks', 'Strike together'],
    rulesIndex: '01 / THE RULES',
    rulesTitleFirst: 'The first strike',
    rulesTitleSecond: 'is the best read.',
    rulesIntro: 'Head Clash is a portrait mode, simultaneous turn based physics battle. Both players secretly choose where to move, then aim based on their new positions. Once locked in, both heads launch at the same time.',
    readIndex: '01 / READ',
    readTitle: 'Move in secret',
    readText: 'Predict your opponent’s next step. Both positions change only after each player has chosen.',
    bounceIndex: '02 / BOUNCE',
    bounceTitle: 'Bank your shot',
    bounceText: 'Bounce off pillars and walls to change your path and find an angle around frontal defenses.',
    hitIndex: '03 / HIT',
    hitTitle: 'Aim for the body',
    hitText: 'Necks block attacks; only a hit to the body deals damage. Knock your opponent out of the arena or reduce their health to zero to win.',
    arenaIndex: '02 / IN THE ARENA',
    arenaTitleFirst: 'Stretch. Bounce.',
    arenaTitleSecond: 'One moment decides it.',
    arenaText: 'Choose your position, then choose your attack. Heads, necks, obstacles, and arena edges create new paths every turn.',
    mapCount: 'arena maps',
    duelType: 'simultaneous 1v1 battle',
    screenshotNote: 'Actual gameplay screens from a version in development.',
    battleAlt: 'Head Clash gameplay showing characters stretching their necks and attacking at the same time in a circular arena',
    battleCaption: 'SIMULTANEOUS STRIKE',
    homeAlt: 'Head Clash main menu showing a character and options for online matchmaking and AI battles',
    homeCaption: 'HOME SCREEN',
    modesIndex: '03 / CHOOSE YOUR MATCH',
    modesTitleFirst: 'Train on your own,',
    modesTitleSecond: 'or face a real rival.',
    soloIndex: '01 / SOLO',
    soloTitle: 'AI battle',
    soloText: 'Choose an arena and practice positioning, angles, and bank shots against AI.',
    onlineIndex: '02 / ONLINE',
    onlineTitle: 'Random 1v1',
    onlineText: 'Match with a real player online and test your reads in simultaneous turns.',
    languageLabel: 'Interface languages',
    languageList: '简体中文 · 日本語 · English',
    closingIndex: 'HEAD CLASH / IN DEVELOPMENT',
    closingFirst: 'See you',
    closingSecond: 'next turn.',
    closingText: 'Head Clash is in development for mobile. Public download details will be announced when ready.',
    backToWorks: 'Back to all work',
    privacyLabel: 'Privacy policy',
    supportLabel: 'Game support',
  },
} as const;
const t = copy[locale];
const gamePath = localizedPath(site.headClash.path, locale);
const homeWorksPath = `${localizedPath('/', locale)}#works`;
---

<BaseLayout
  title={`${t.name}｜${site.name}`}
  description={t.description}
  lang={locale === 'zh' ? 'zh-CN' : locale}
  ogImage="/head-clash/hero.jpg"
  ogWidth={1536}
  ogHeight={1024}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: t.name,
    alternateName: [site.headClash.name, site.headClash.englishName],
    description: t.description,
    inLanguage: locale === 'zh' ? 'zh-CN' : locale,
    url: new URL(gamePath, site.url),
    image: new URL('/head-clash/icon.png', site.url),
    gamePlatform: ['iOS', 'Android'],
    operatingSystem: ['iOS', 'Android'],
    author: { '@type': 'Organization', name: site.name },
  }}
>
  <div id="top" class="hc-page" data-locale={locale}>
    <Header context="game" />

    <main id="main">
      <section class="hc-hero" aria-labelledby="hc-title">
        <div class="shell hc-hero-grid">
          <div class="hc-hero-copy">
            <div class="hc-lockup">
              <img src="/head-clash/icon.png" alt={t.iconAlt} width="80" height="80" />
              <div><span>{t.presents}</span><strong>HEAD CLASH</strong></div>
            </div>
            <p class="hc-eyebrow">{t.eyebrow}</p>
            <h1 id="hc-title">{t.titleFirst}<br /><em>{t.titleSecond}</em><span aria-hidden="true">!</span></h1>
            <p class="hc-hero-lede">{t.heroLineOne}<br />{t.heroLineTwo}</p>
            <div class="hc-hero-actions">
              <a class="hc-button" href="#how-to-play">{t.learnRules} <span aria-hidden="true">↘</span></a>
              <span class="hc-status"><i aria-hidden="true"></i>{t.status}</span>
            </div>
            <p class="hc-hero-foot">{t.availability}</p>
          </div>

          <figure class="hc-hero-art">
            <div class="hc-art-top"><span>HEAD CLASH / 001</span><span>{t.simultaneous}</span></div>
            <img src="/head-clash/hero.jpg" alt={t.heroAlt} width="1536" height="1024" />
            <figcaption>{t.heroCaption} <span>↗</span></figcaption>
          </figure>
        </div>
        <div class="hc-hero-index" aria-hidden="true"><span>{t.gameIndex}</span><span>{t.scroll}</span></div>
      </section>

      <div class="hc-rule-strip" aria-label={t.flowLabel}>
        <div class="shell"><span>{t.flow[0]}</span><b>→</b><span>{t.flow[1]}</span><b>→</b><span>{t.flow[2]}</span><b>→</b><span>{t.flow[3]}</span></div>
      </div>

      <section id="how-to-play" class="hc-section hc-mechanics" aria-labelledby="hc-mechanics-title">
        <div class="shell hc-section-intro">
          <p class="hc-index">{t.rulesIndex}</p>
          <div>
            <h2 id="hc-mechanics-title">{t.rulesTitleFirst}<br /><em>{t.rulesTitleSecond}</em></h2>
            <p>{t.rulesIntro}</p>
          </div>
        </div>
        <div class="shell hc-mechanic-grid">
          <article>
            <span>{t.readIndex}</span>
            <div class="hc-card-symbol" aria-hidden="true">↗</div>
            <h3>{t.readTitle}</h3>
            <p>{t.readText}</p>
          </article>
          <article>
            <span>{t.bounceIndex}</span>
            <div class="hc-card-symbol" aria-hidden="true">⤴</div>
            <h3>{t.bounceTitle}</h3>
            <p>{t.bounceText}</p>
          </article>
          <article>
            <span>{t.hitIndex}</span>
            <div class="hc-card-symbol" aria-hidden="true">✳</div>
            <h3>{t.hitTitle}</h3>
            <p>{t.hitText}</p>
          </article>
        </div>
      </section>

      <section class="hc-screens" aria-labelledby="hc-screens-title">
        <div class="shell hc-screens-grid">
          <div class="hc-screens-copy">
            <p class="hc-index">{t.arenaIndex}</p>
            <h2 id="hc-screens-title">{t.arenaTitleFirst}<br /><em>{t.arenaTitleSecond}</em></h2>
            <p>{t.arenaText}</p>
            <div class="hc-visual-facts">
              <div><strong>06</strong><span>{t.mapCount}</span></div>
              <div><strong>1V1</strong><span>{t.duelType}</span></div>
            </div>
            <p class="hc-screenshot-note">{t.screenshotNote}</p>
          </div>
          <div class="hc-phone-pair">
            <figure class="hc-phone hc-phone--battle">
              <img src="/head-clash/battle.png" alt={t.battleAlt} width="1080" height="1920" loading="lazy" />
              <figcaption><span>01</span> {t.battleCaption}</figcaption>
            </figure>
            <figure class="hc-phone hc-phone--home">
              <img src="/head-clash/home.png" alt={t.homeAlt} width="1080" height="1920" loading="lazy" />
              <figcaption><span>02</span> {t.homeCaption}</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="hc-modes" aria-labelledby="hc-modes-title">
        <div class="shell">
          <div class="hc-modes-heading">
            <p class="hc-index">{t.modesIndex}</p>
            <h2 id="hc-modes-title">{t.modesTitleFirst}<br />{t.modesTitleSecond}</h2>
          </div>
          <div class="hc-mode-grid">
            <article>
              <span>{t.soloIndex}</span>
              <h3>{t.soloTitle}</h3>
              <p>{t.soloText}</p>
              <strong aria-hidden="true">↗</strong>
            </article>
            <article>
              <span>{t.onlineIndex}</span>
              <h3>{t.onlineTitle}</h3>
              <p>{t.onlineText}</p>
              <strong aria-hidden="true">↗</strong>
            </article>
          </div>
          <p class="hc-language">{t.languageLabel} <span>{t.languageList}</span></p>
        </div>
      </section>

      <section class="hc-close" aria-labelledby="hc-close-title">
        <div class="shell hc-close-grid">
          <img src="/head-clash/icon.png" alt="" width="140" height="140" loading="lazy" />
          <div>
            <p class="hc-index">{t.closingIndex}</p>
            <h2 id="hc-close-title">{t.closingFirst}<br />{t.closingSecond}</h2>
            <p>{t.closingText}<span class="hc-help"><a href={localizedPath(site.headClash.privacyPath, locale)}>{t.privacyLabel}</a><a href={`mailto:${site.gameSupportEmail}`}>{t.supportLabel}</a></span></p>
          </div>
          <a href={homeWorksPath}>{t.backToWorks} <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  .hc-page { overflow: hidden; color: #193b35; background: #f8f7ef; }
  .hc-page :global(.site-header) { color: #fff; }
  .hc-page :global(.site-header .header-inner) { border-color: rgba(255, 255, 255, .2); }
  .hc-page :global(.site-header .brand),
  .hc-page :global(.site-header .nav-cta) { color: #fff; }
  .hc-page :global(.site-header nav a:not(.nav-cta):hover) { color: #fbd06a; }

  .hc-hero { position: relative; min-height: 800px; padding-top: 160px; background: #173b34; color: #fffdf3; }
  .hc-hero::before { position: absolute; inset: 0; content: ''; opacity: .16; background: radial-gradient(circle at 16% 72%, #7abd9c, transparent 30%), radial-gradient(circle at 82% 10%, #fbd06a, transparent 24%); pointer-events: none; }
  .hc-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(390px, .85fr) minmax(0, 1.15fr); gap: clamp(35px, 5vw, 85px); align-items: center; padding-bottom: 104px; }
  .hc-hero-copy { padding-block: 25px; }
  .hc-lockup { display: flex; align-items: center; gap: 16px; }
  .hc-lockup img { width: 66px; height: 66px; border: 1px solid rgba(255, 255, 255, .35); border-radius: 15px; }
  .hc-lockup div { display: grid; gap: 6px; }
  .hc-lockup span, .hc-eyebrow, .hc-index, .hc-art-top, .hc-hero-index, .hc-mechanic-grid article > span, .hc-mode-grid article > span { font-size: .62rem; font-weight: 760; letter-spacing: .18em; }
  .hc-lockup span { color: #b6cfbf; }
  .hc-lockup strong { font-size: .9rem; letter-spacing: .11em; }
  .hc-eyebrow { margin-top: 76px; color: #fbd06a; }
  .hc-hero h1 { margin-top: 20px; font-size: clamp(5.8rem, 10vw, 10rem); font-weight: 780; line-height: .82; letter-spacing: -.09em; }
  .hc-page[data-locale='ja'] .hc-hero h1 { font-size: clamp(3.1rem, 5vw, 5.5rem); }
  .hc-page[data-locale='en'] .hc-hero h1 { font-size: clamp(4.8rem, 6.5vw, 7rem); }
  .hc-hero h1 em { color: #fbd06a; font-style: normal; }
  .hc-hero h1 span { display: inline-block; margin-left: .07em; color: #f28a65; transform: rotate(11deg); }
  .hc-hero-lede { margin-top: 34px; color: #d5e2d8; font-size: clamp(.96rem, 1.3vw, 1.15rem); line-height: 1.9; }
  .hc-hero-actions { display: flex; flex-wrap: wrap; gap: 23px; align-items: center; margin-top: 43px; }
  .hc-button { display: inline-flex; min-width: 170px; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 19px; color: #183a33; background: #fbd06a; font-size: .79rem; font-weight: 800; transition: transform .18s ease, background .18s ease; }
  .hc-button:hover { background: #ffe29a; transform: translateY(-2px); }
  .hc-button span { font-size: 1.1rem; }
  .hc-status { display: inline-flex; align-items: center; gap: 9px; color: #d8e8dc; font-size: .74rem; font-weight: 700; }
  .hc-status i { width: 7px; height: 7px; border-radius: 50%; background: #fbd06a; box-shadow: 0 0 0 5px rgba(251, 208, 106, .13); }
  .hc-hero-foot { margin-top: 25px; color: #a9c1b2; font-size: .7rem; }
  .hc-hero-art { position: relative; padding: 17px; background: #fbfaf2; box-shadow: 20px 24px 0 rgba(4, 24, 18, .28); transform: rotate(1.4deg); }
  .hc-art-top { display: flex; justify-content: space-between; gap: 12px; padding: 3px 3px 16px; color: #315248; }
  .hc-hero-art img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
