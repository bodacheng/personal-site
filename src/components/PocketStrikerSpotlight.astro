---
import { site } from '../config/site';
import { pocketStrikerCopy } from '../content/pocketStriker';
import { localeFromPath, localizedPath } from '../i18n';

interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = pocketStrikerCopy[locale];
const projectPath = localizedPath(site.pocketStriker.path, locale);
const titleId = compact ? 'home-pocket-striker-title' : 'pocket-striker-title';
---

<section id={compact ? 'pocket-striker-project' : undefined} class:list={['pocket-spotlight', { compact }]} aria-labelledby={titleId}>
  <div class="shell pocket-spotlight-inner">
    <div class="pocket-copy">
      <p class="pocket-eyebrow">{compact ? '03 / GAME' : 'HOTARU STUDIO PRESENTS'} <span>{t.category}</span></p>
      {compact ? <h2 id={titleId}>Pocket<br /><em>Striker</em></h2> : <h1 id={titleId}>Pocket<br /><em>Striker</em></h1>}
      <p class="pocket-tagline">{t.tagline}</p>
      <p class="pocket-description">{t.description}</p>
      <ul class="pocket-tags" aria-label={t.tagsLabel}>{t.tags.map(tag => <li>{tag}</li>)}</ul>
      <div class="pocket-actions">
        <a class="pocket-primary" href={compact ? projectPath : '#support'}>{compact ? t.explore : t.support} <span aria-hidden="true">→</span></a>
        {compact && <a href={`${projectPath}#support`}>{t.support}</a>}
        {!compact && <a href={localizedPath(site.pocketStriker.privacyPath, locale)}>{t.privacy}</a>}
      </div>
    </div>
    <figure class="pocket-icon-stage">
      <div class="pocket-orbit" aria-hidden="true"></div>
      <img src="/pocket-striker/app-icon.png" alt={t.iconAlt} width="192" height="192" loading={compact ? 'lazy' : 'eager'} />
      <figcaption><span>9 SLOTS</span><strong>BUILD YOUR COMBO</strong></figcaption>
    </figure>
  </div>
</section>

<style>
  .pocket-spotlight { color: #f7f7f2; background: #10151b; border-top: 1px solid #2c343d; }
  .pocket-spotlight-inner { display: grid; grid-template-columns: 1.2fr .8fr; align-items: center; gap: 80px; padding-block: 180px 100px; }
  .compact .pocket-spotlight-inner { padding-block: 100px; }
  .pocket-eyebrow { display: flex; flex-wrap: wrap; gap: 14px 28px; color: #85a7a8; font-size: .62rem; font-weight: 760; letter-spacing: .14em; }
  .pocket-eyebrow span { color: #e6b768; letter-spacing: .04em; }
  h1, h2 { margin-top: 36px; font-size: clamp(4rem, 7.2vw, 7rem); font-weight: 760; line-height: .88; letter-spacing: -.065em; }
  h1 em, h2 em { color: #e6b768; font-style: normal; }
  .pocket-tagline { margin-top: 32px; font-size: clamp(1.05rem, 2vw, 1.4rem); line-height: 1.55; font-weight: 650; }
  .pocket-description { max-width: 600px; margin-top: 20px; color: #b1bbc4; font-size: .95rem; line-height: 1.9; }
  .pocket-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .pocket-tags li { border: 1px solid #384750; padding: 9px 12px; color: #c5dada; font-size: .68rem; }
  .pocket-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 34px; font-size: .78rem; font-weight: 700; }
  .pocket-actions a { min-height: 44px; display: inline-flex; align-items: center; }
  .pocket-primary { justify-content: space-between; gap: 32px; padding: 16px 22px; color: #11151c; background: #e6b768; }
  .pocket-primary:hover { background: #f4cd8d; }
  .pocket-actions a:not(.pocket-primary):hover { color: #e6b768; }
  .pocket-icon-stage { position: relative; display: grid; justify-items: center; align-content: center; min-height: 410px; isolation: isolate; }
  .pocket-orbit { position: absolute; z-index: -1; top: 50%; left: 50%; width: min(100%, 400px); aspect-ratio: 1; transform: translate(-50%, -50%); border: 1px solid #384750; border-radius: 50%; background: radial-gradient(circle, #23423f 0, #17262a 40%, transparent 69%); }
  .pocket-orbit::before { position: absolute; inset: 26px; border: 1px solid #384750; border-radius: 50%; content: ''; }
  .pocket-icon-stage img { width: 240px; height: 240px; border-radius: 24px; box-shadow: 0 28px 60px #080a1099; image-rendering: auto; }
  figcaption { display: grid; gap: 8px; margin-top: 28px; text-align: center; }
  figcaption span { color: #e6b768; font-size: .65rem; letter-spacing: .22em; }
  figcaption strong { color: #c5dada; font-size: .72rem; letter-spacing: .16em; }
  @media (max-width: 900px) {
    .pocket-spotlight-inner { gap: 32px; grid-template-columns: 1fr 300px; }
    .pocket-icon-stage img { width: 192px; height: 192px; }
  }
  @media (max-width: 700px) {
    .pocket-spotlight-inner { grid-template-columns: 1fr; gap: 48px; padding-block: 140px 64px; }
    .compact .pocket-spotlight-inner { padding-block: 64px; }
    h1, h2 { font-size: clamp(3.8rem, 16vw, 6rem); }
    .pocket-icon-stage { min-height: 300px; }
    .pocket-orbit { max-width: 300px; }
    .pocket-description { font-size: .9rem; }
  }
</style>
