---
import type { Project } from '../config/site';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const Tag = project.href ? 'a' : 'article';
---

<Tag
  class:list={['project-card', { 'project-card--link': project.href }]}
  {...(project.href ? { href: project.href, target: '_blank', rel: 'noreferrer' } : {})}
>
  <div class="project-topline">
    <span class="project-index">0{index + 1}</span>
    {project.status && <span class="project-status">{project.status}</span>}
  </div>
  <div>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
  </div>
  <div class="project-footer">
    <ul aria-label="项目技术与领域">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    {project.href && <span aria-hidden="true">↗</span>}
  </div>
</Tag>
